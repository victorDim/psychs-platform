# Runtime mode. Production and staging fail startup when critical secrets are absent.
PSYCHS_ENVIRONMENT=development
PSYCHS_EXECUTION_MODE=HYBRID_SANDBOX

# Local demo escape hatches. Never enable these in staging or production.
PSYCHS_ALLOW_INSECURE_DEMO_AUTH=false
PSYCHS_ALLOW_LEGACY_SERVER=false
PSYCHS_V2_ENABLED=false

# Generate this in a secret manager for production (minimum 32 characters).
PSYCHS_JWT_SIGNING_KEY=
PSYCHS_JWT_ISSUER=psychs-platform
PSYCHS_JWT_AUDIENCE=psychs-api

# Exact browser origins, comma-separated. Wildcards are not supported.
PSYCHS_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Data services (the legacy server does not yet use these as systems of record).
DATABASE_URL=
# Use a distinct owner credential only for Alembic; the API credential must be
# a non-owner role so PostgreSQL RLS remains effective.
MIGRATION_DATABASE_URL=
DATABASE_APP_USER=psychs_app
DATABASE_APP_PASSWORD=
REDIS_URL=

# Managed OIDC provider configuration for API v2. Only asymmetric algorithms
# are accepted in staging and production.
PSYCHS_OIDC_ISSUER=
PSYCHS_OIDC_AUDIENCE=psychs-api
PSYCHS_OIDC_JWKS_URL=
PSYCHS_OIDC_ALGORITHMS=RS256

# Public frontend OIDC client configuration. These values are compiled into
# the Vite bundle and must never contain an OIDC client secret. Register
# /auth/callback as an exact redirect URI at the identity provider.
VITE_API_BASE_URL=/api/v2
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_AUDIENCE=psychs-api
VITE_OIDC_SCOPE=openid profile email offline_access projects:read projects:write
VITE_ENABLE_LEGACY_DEMO_UI=false

# Provider credentials. Leave unset to make live collection unavailable.
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GLM_API_KEY=
GROK_API_KEY=

# Optional outbound proxy. Store the live value in a secret manager.
PROXY_ROTATING_URL=
PROXY_PROVIDER_NAME=
PROXY_TOTAL_ONLINE=0
